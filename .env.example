# Copy to .env. compose.yaml (local development) has defaults for the passwords;
# compose.prod.yaml refuses to start without them.
MYSQL_ROOT_PASSWORD=florin-root-dev
MYSQL_PASSWORD=florin

# compose.prod.yaml: port nginx listens on, and the public URL customers use (CORS).
WEB_PORT=80
PUBLIC_ORIGIN=http://localhost
BACKEND_REPLICAS=1

# Seed a demo customer (demo@example.com / florin-demo) with four months of history on first start.
FLORIN_DEMO_SEED=true
